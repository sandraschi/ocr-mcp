{
    "product_name": "OCR MCP",
    "install_dir": "%LOCALAPPDATA%\\OCR MCP",
    "operator_exe": "ocr-mcp-native.exe",
    "backend_process_names": ["ocr-mcp-native", "ocr-mcp-backend"],
    "backend_port": 10859,
    "health_path": "/api/v1/health",
    "diagnostics_path": "/api/v1/diagnostics",
    "feature_smoke_path": "/api/v1/system/info",
    "window_title_re": "OCR MCP",
    "nsis_glob": "native/target/release/bundle/nsis/OCR MCP_*_x64-setup.exe",
    "bridge_ok_text": "REST bridge reachable",
    "uninstall_registry_filter": "*OCR MCP*",
    "nav_routes": [
        { "label": "Dashboard", "route": "/" },
        { "label": "Inbox", "route": "/inbox" },
        { "label": "Form Filler", "route": "/forms" },
        { "label": "Corpus Depot", "route": "/depot" },
        { "label": "Chat", "route": "/chat" },
        { "label": "Tools", "route": "/tools" },
        { "label": "Skills", "route": "/skills" },
        { "label": "Logs", "route": "/logs" },
        { "label": "Settings", "route": "/settings" },
        { "label": "Help", "route": "/help" }
    ]
}
