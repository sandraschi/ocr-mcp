# OCR-MCP Configuration
# Copy to .env and modify as needed

# OCR Backend Settings
OCR_CACHE_DIR=~/.cache/ocr-mcp
OCR_MODEL_DIR=
OCR_DEVICE=auto
OCR_DEFAULT_BACKEND=unlimited-ocr
OCR_BATCH_SIZE=4
OCR_MAX_CONCURRENT=4
OCR_MAX_MEMORY=

# Mistral OCR (optional - cloud API)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Tesseract (optional - override PATH)
TESSERACT_CMD=

# Poppler (optional - PDF rendering)
POPPLER_PATH=

# Sampling (optional - for agentic workflows)
OCR_SAMPLING_USE_CLIENT_LLM=0
OCR_SAMPLING_USE_OPENAI_KEY=0
OCR_SAMPLING_API_KEY=
OCR_SAMPLING_BASE_URL=http://127.0.0.1:11434/v1
OCR_SAMPLING_MODEL=llama3.2

# Watch folder (optional - auto OCR on new files)
OCR_WATCH_FOLDER_ENABLED=0
OCR_WATCH_FOLDER_PATH=
OCR_WATCH_FOLDER_OUTPUT=
OCR_WATCH_FOLDER_INTERVAL=10

# Document corpus (optional - SQLite index location)
OCR_CORPUS_DIR=

# Scanner Bridge (optional - for WIA-over-Docker)
# Default: http://127.0.0.1:15002
# Set to http://host.docker.internal:15002 when ocr-mcp runs inside Docker.
OCR_SCANNER_BRIDGE_URL=

# Startup bootstrap (defaults to on)
OCR_AUTO_BOOTSTRAP=1
OCR_AUTO_INSTALL_DEPS=0
OCR_AUTO_INSTALL_POPPLER=0
OCR_AUTO_INSTALL_TESSERACT=0

# Webapp
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=10859

# MCP transport (stdio | http)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=10859
MCP_PATH=/mcp
